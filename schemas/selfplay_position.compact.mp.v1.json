{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCZero compact multiplayer self-play position v1",
  "type": "object",
  "required": [
    "type",
    "schema",
    "game_id",
    "seed",
    "ply",
    "player_count",
    "player",
    "seat",
    "seat_order",
    "hash",
    "cells",
    "model_id",
    "rule_profile",
    "placements",
    "score_vector",
    "result_vector",
    "chosen_action",
    "actions",
    "visits",
    "visit_sum"
  ],
  "properties": {
    "type": {"const": "selfplay_position"},
    "schema": {"const": "cczero.selfplay.compact.mp.v1"},
    "game_id": {"type": "integer"},
    "seed": {"type": "integer"},
    "ply": {"type": "integer", "minimum": 0},
    "player_count": {"type": "integer", "enum": [3, 4, 6]},
    "player": {"type": "integer", "minimum": 0, "maximum": 5},
    "seat": {"type": "integer", "minimum": 0, "maximum": 5},
    "seat_order": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {"type": "integer", "minimum": 0, "maximum": 5}
    },
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{16}(:[A-Za-z0-9_.-]+)?$"},
    "cells": {"type": "string", "minLength": 121, "maxLength": 121, "pattern": "^[.012345]{121}$"},
    "model_id": {"type": "string"},
    "target_model_id": {"type": "string"},
    "rule_profile": {"type": "string", "enum": ["CCZ-121-MP3-v1", "CCZ-121-MP4-v1", "CCZ-121-MP6-v1"]},
    "winner_seats": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 5}
    },
    "placements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {"type": "integer", "minimum": 1, "maximum": 6}
    },
    "score_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "result_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "source_iter": {"type": "integer", "minimum": 0},
    "target_age": {"type": "integer", "minimum": 0},
    "requested_simulations": {"type": "integer", "minimum": 0},
    "actual_simulations": {"type": "integer", "minimum": 0},
    "search_config_hash": {"type": "string"},
    "target_model_strength_tier": {"type": "string"},
    "trusted_target": {"type": "boolean"},
    "phase": {"type": "integer"},
    "chosen_action": {"type": "integer", "minimum": 0, "maximum": 14640},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0, "maximum": 14640}
    },
    "visits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "priors": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "visit_sum": {"type": "integer", "minimum": 0}
  }
}
